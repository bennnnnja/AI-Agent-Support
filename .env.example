REDIS_URL=redis://localhost:6379
REDIS_STREAM=support-stream
REDIS_GROUP=agent-group
REDIS_CONSUMER=agent-1

OLLAMA_URL=http://10.60.18.220:11434
OLLAMA_MODEL=llama3

JIRA_URL=http://10.60.18.220:30280
JIRA_TOKEN=""

RAG_API_URL=http://10.10.10.5:9621
RAG_API_KEY=""
# RAG API path prefix (e.g. "/api" if LightRAG sits behind a reverse proxy). Empty = no prefix.
RAG_API_PREFIX=
# Включить LLM-синтез поверх найденных RAG-результатов (false = вернуть сырой RAG).
RAG_USE_LLM_SYNTHESIS=false

# Bot identity — exact Jira username of the agent (for filtering own comments)
BOT_USERNAME=Agent

# Jira workflow — transition names (must match Jira transition names exactly).
# Run `list_tools_detailed()` or check Jira Admin → Workflows to find names.
# Leave empty to disable a given transition.
STATUS_IN_PROGRESS=Start Progress
STATUS_ESCALATED=
STATUS_RESOLVED=Done

# Username to reassign the ticket to on escalation (empty = keep current assignee)
ESCALATION_ASSIGNEE=Support

# Statuses that mean "ticket is escalated, agent should not respond".
# Comma-separated, case-insensitive. Do NOT include normal working statuses
# like "In Progress" here — only statuses that mean a human has taken over.
# ESCALATION_STATUSES=Escalated,Waiting for support

# ─────────────────────────────────────────────────────────────────────
# Контракт JSON-payload в Redis Stream (поля, которые читает агент):
#   issue_key       (required)  — Jira key, напр. "SUP-123"
#   event_type      (required)  — issue_created | comment_created | comment_added | issue_updated
#   summary, body   (optional)  — текст события (body для комментариев, summary для issue_created)
#   author, role,
#   source          (optional)  — для фильтрации (бот/саппорт/пользователь)
#   status          (optional)  — текущий статус Jira (для фильтра ESCALATION_STATUSES)
#   priority        (optional)  — приоритет тикета (Jira enum: Highest|High|Medium|Low|Lowest);
#                                 используется только для логов/эвристик classify (highest/high → log)
#   force_escalation,
#   super_priority,
#   needs_human     (optional)  — флаги от микросервиса Priority; любой True → эскалация без RAG/LLM
# ─────────────────────────────────────────────────────────────────────

# HTTP health endpoint port (used by Docker/k8s liveness probes)
# HEALTH_PORT=8080